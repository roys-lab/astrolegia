# =============================================================================
# Astrolegia web (apps/web) — variables de entorno
# Copiá este archivo a apps/web/.env.local. En Vercel, cargalas en
# Project Settings → Environment Variables.
#
# La web ya no habla con Firebase ni con proveedores externos: todo pasa por la
# única API backend (auth, personas, cartas, geocoding, IA). Las claves de
# RapidAPI / Gemini / Google OAuth viven en apps/api/.env.example.
# =============================================================================

# URL pública de la API (sin barra final). Local: http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Versión que la web declara en la cabecera X-App-Version (doc 02)
NEXT_PUBLIC_APP_VERSION=0.1.0
