# ========================================================
#   Astrolegia API — variables de entorno
#   Local: copiar a apps/api/.env. Railway: cargarlas en el servicio `api`.
# ========================================================

PORT=3000
NODE_ENV=development

# PostgreSQL (en Railway: la URL privada del servicio postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/astrolegia?schema=public"

# --- Identidad: Better Auth + Google SSO (docs 07 y 08) ---
# URL pública de la API (sin barra final). El callback de Google que hay que
# registrar en Google Cloud Console es <BETTER_AUTH_URL>/v1/auth/callback/google
BETTER_AUTH_URL=http://localhost:3000
# Secreto de firma de sesiones: obligatorio en producción (>= 32 caracteres aleatorios)
BETTER_AUTH_SECRET=
# OAuth client de Google Cloud Console (tipo "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "true" solo si la web vive en otro sitio que la API (p. ej. *.vercel.app
# contra api.astrolegia.com): cookies SameSite=None; Secure
AUTH_CROSS_SITE_COOKIES=false
# Orígenes extra separados por coma (previews de Vercel, etc.)
AUTH_TRUSTED_ORIGINS=

# --- Frontends (CORS y redirecciones de login) ---
WEB_URL=http://localhost:3003
ADMIN_URL=http://localhost:3001
CLIENT_URL=http://localhost:3002

# --- Proveedores externos ---
# Cartas natales: Astrologer API v5 en RapidAPI
RAPIDAPI_KEY=
RAPIDAPI_HOST=
# Interpretación con IA (Gemini). Sin ella, /v1/client/astrology/interpret responde CONFIGURATION_ERROR
GEMINI_API_KEY=
# Opcional: redacción con Claude; sin ella cae a Gemini
ANTHROPIC_API_KEY=
# Opcional: ruta al knowledge-base.json del RAG (por defecto apps/api/data/knowledge-base.json; si no existe, el RAG se omite)
KNOWLEDGE_BASE_PATH=
