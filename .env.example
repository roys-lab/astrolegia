# ========================================================
#   Astrolegia — Environment Variables Example
#   Duplica este archivo como .env para configuración local
# ========================================================

# Puertos estrictos del sistema
API_PORT=3000
ADMIN_PORT=3001
CLIENT_PORT=3002
WEB_PORT=3003

# URLs de servicios locales
API_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CLIENT_URL=http://localhost:3002
WEB_URL=http://localhost:3003

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/astrolegia?schema=public

# Google Cloud OAuth (Single Sign-On)
# Completa estos valores al obtener las credenciales de Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web de consultantes (Next.js, apps/web). Conexión a la API vía apps/web/.env.local:
# ver apps/web/.env.example

# Identidad (Better Auth en la API). La API lee su propio apps/api/.env, que
# tiene la lista completa; estas quedan acá como referencia del sistema.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
