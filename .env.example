# ========================================================
#   Astrolegia — Environment Variables Example
#   Duplica este archivo como .env para configuración local
# ========================================================

# Puertos estrictos del sistema
API_PORT=3000
ADMIN_PORT=3001
CLIENT_PORT=3002

# URLs de servicios locales
API_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CLIENT_URL=http://localhost:3002

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/astrolegia?schema=public

# Google Cloud OAuth (Single Sign-On)
# Completa estos valores al obtener las credenciales de Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
